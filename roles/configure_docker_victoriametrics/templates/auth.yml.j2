{# Paths: <vmauth>/metrics -> victoriametrics, /logs -> victorialogs (journald + OPNsense syslog), /firewall -> firewall logs #}
{% macro url_map(legacy_paths=false) %}
  url_map:
    - src_paths: ["/metrics/.*"]
      url_prefix: "http://victoriametrics:8428"
      drop_src_path_prefix_parts: 1
    - src_paths: ["/logs/.*"]
      url_prefix: "http://victorialogs:9428"
      drop_src_path_prefix_parts: 1
    - src_paths: ["/firewall/.*"]
      url_prefix: "http://victorialogs-firewall:9428"
      drop_src_path_prefix_parts: 1
{% if legacy_paths %}
    # Legacy unprefixed paths, only for clients that haven't re-run since the /metrics /logs split
    - src_paths: ["/insert/.*", "/select/.*"]
      url_prefix: "http://victorialogs:9428"
    - src_paths: ["/.*"]
      url_prefix: "http://victoriametrics:8428"
{% endif %}
{% endmacro %}
users:
# systemd-journal-upload on every host, can only push logs
- username: "journal"
  password: "{{ secret_victorialogs_journal_password }}"
  url_map:
    - src_paths: ["/logs/insert/journald/.*"]
      url_prefix: "http://victorialogs:9428"
      drop_src_path_prefix_parts: 1
    # ponytail: legacy, only bigbilly still uses it (unreachable 2026-11-24), remove once it has re-run configure_journal_upload
    - src_paths: ["/insert/journald/.*"]
      url_prefix: "http://victorialogs:9428"
{% for token in victoriametrics_bearer_tokens %}
# {{ token.name }}
- bearer_token: "{{ token.token }}"
{{ url_map(token.legacy_paths | default(false)) }}
{% endfor %}
{% for user in victoriametrics_users %}
- username: "{{ user.name }}"
  password: "{{ user.password }}"
{{ url_map() }}
{% endfor %}
