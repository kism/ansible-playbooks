[Unit]
Description=allowlistapp IP allowlist app for nginx
After=network.target

[Service]
User=nginx
WorkingDirectory=/opt/allowlistapp
# Single process on purpose, the allowlist lives in memory. X-Forwarded-For is only trusted from 127.0.0.1 (the default).
ExecStart=/opt/allowlistapp/.venv/bin/allowlistapp --host 127.0.0.1 --port 8080 --instance-path /opt/allowlistapp/instance
Restart=always

[Install]
WantedBy=multi-user.target
