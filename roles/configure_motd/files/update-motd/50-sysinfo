#!/bin/sh
# Hostname is left out, 10-header prints it

. /etc/os-release
printf "      OS: %s, up %s\n" "$PRETTY_NAME" \
    "$(uptime -p | sed 's/^up //; s/ weeks\?/w/; s/ days\?/d/; s/ hours\?/h/; s/ minutes\?/m/; s/,//g')"

# Ubuntu only
stamp=/var/lib/update-notifier/updates-available
if [ -r "$stamp" ]; then
    n=$(awk '/updates can be applied immediately/ {print $1}' "$stamp")
    sec=$(awk '/standard security updates/ {print $1}' "$stamp")
    if [ "${n:-0}" != 0 ]; then
        printf " Updates: %s%s\n" "$n" "${sec:+ ($sec security)}"
    fi
fi

printf "    Load: %s on %s CPUs\n" "$(cut -d' ' -f1 /proc/loadavg)" "$(nproc --all)"

free -h --si | awk '
    /^Mem/ {ram = $3 "/" $2}
    /^Swap/ && $2 != "0B" {swap = ", " $3 "/" $2 " swap"}
    END {printf "  Memory: %s RAM%s\n", ram, swap}'

printf "    Disk:"
sep=""
for m in / /mnt/scratch; do
    mountpoint -q "$m" || continue
    df -h "$m" | awk -v m="$m" -v s="$sep" 'NR==2 {printf "%s %s %s/%s (%s)", s, m, $3, $2, $5}'
    sep=","
done
printf "\n"

if pgrep tmux >/dev/null; then
    printf "    tmux: running\n"
fi
