# {{ ansible_managed }}
[Interface]
PrivateKey = {{ secret_proton_wireguard_private_key }}
Address = {{ secret_proton_wireguard_address }}
# Don't touch the main table: tailscaled's own traffic stays on the LAN so peers connect direct instead of via DERP.
# Only traffic forwarded in from tailscale0 (exit node clients) is policy routed into the tunnel.
Table = off
PostUp = ip route replace default dev %i table 51820
# Kill switch: the unreachable routes and the rules are never removed, so with wg0 down exit traffic is dropped, not leaked out the LAN.
PostUp = ip route replace unreachable default metric 4096 table 51820
PostUp = ip -6 route replace unreachable default table 51820
# wg-quick runs hooks with set -e, so the del (no rule on first up) needs || true
PostUp = ip rule del priority 100 2>/dev/null || true; ip rule add iif tailscale0 lookup 51820 priority 100
PostUp = ip -6 rule del priority 100 2>/dev/null || true; ip -6 rule add iif tailscale0 lookup 51820 priority 100

[Peer]
PublicKey = {{ proton_wireguard_peer_public_key }}
Endpoint = {{ proton_wireguard_endpoint }}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
