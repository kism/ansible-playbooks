server {
    return 301 https://{{ inventory_hostname }}.{{ homelab_domain_external }}:8006$request_uri;
    server_name {{ inventory_hostname }}.{{ homelab_domain_external }};
    listen 443 ssl;
    ssl_certificate /etc/pve/local/pveproxy-ssl.pem; # PVE ACME cert, full chain, pve_nginx_reload.timer picks up renewals
    ssl_certificate_key /etc/pve/local/pveproxy-ssl.key;
}
