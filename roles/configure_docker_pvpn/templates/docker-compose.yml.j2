---
services:
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=protonvpn
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY={{ secret_proton_wireguard_private_key }}
      - WIREGUARD_ADDRESSES={{ secret_proton_wireguard_address }}
      - SERVER_COUNTRIES=Netherlands
      - TZ=Australia/Perth
    volumes:
      - ./gluetun:/gluetun
    restart: always

  # ponytail: userspace networking so exit node traffic leaves as tailscaled's own sockets, through gluetun's tun. No ip_forward/iptables fighting gluetun's firewall. Kernel mode if throughput matters.
  tailscale:
    image: tailscale/tailscale:latest
    container_name: tailscale
    network_mode: service:gluetun
    # Plain tailscaled, not containerboot: containerboot gives up on interactive login after ~60s and restarts with a new nodekey.
    # Login is done once by hand (see role handler), state and prefs persist in ./tailscale
    entrypoint: ["tailscaled", "--tun=userspace-networking", "--statedir=/var/lib/tailscale"]
    volumes:
      - ./tailscale:/var/lib/tailscale
    restart: unless-stopped
    depends_on:
      gluetun:
        condition: service_healthy
