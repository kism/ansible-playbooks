[Unit]
Description=qBittorrent service with docker compose
PartOf=docker.service
After=docker.service
# No start limit, compose fails straight away while gluetun is unhealthy and that can last longer than a few retries
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ arr_settings_base_dir }}/qbittorrent
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
