# {{ ansible_managed }}
LIBRESPOT_NAME="{{ configure_audio_receiver_name }}"
LIBRESPOT_DEVICE_TYPE="speaker"
LIBRESPOT_BITRATE="320"
LIBRESPOT_INITIAL_VOLUME="50"
LIBRESPOT_BACKEND="alsa"
LIBRESPOT_DEVICE="{{ configure_audio_receiver_alsa_device }}"
# Fixed port so firewalld can allow it, librespot picks a random one otherwise
LIBRESPOT_ZEROCONF_PORT="4070"
LIBRESPOT_DISABLE_AUDIO_CACHE=
LIBRESPOT_QUIET=
