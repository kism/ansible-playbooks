[Unit]
Description=Update cloudflare A/AAAA records to this host's public IPs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/cf_dyndns/cf_dyndns.env
ExecStart={{ ansible_python_interpreter | default('/usr/bin/python3') }} /opt/cf_dyndns/cf_dyndns.py
